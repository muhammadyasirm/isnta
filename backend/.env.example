# MongoDB Atlas Connection String
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/assignmentDB?retryWrites=true&w=majority

# Render injects PORT automatically, for local testing keep 5000
PORT=5000

# Cloudflare Pages Domain (Optional, allows CORS protection)
# Example: https://my-assignment.pages.dev
CLIENT_URL=*